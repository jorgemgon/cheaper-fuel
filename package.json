{
  "name": "cheaper-fuel",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "MCP server for mainland Portugal fuel prices, sourced from DGEG.",
  "license": "MIT",
  "scripts": {
    "dev": "npm run web:build && wrangler dev",
    "deploy": "npm run web:build && wrangler deploy",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && vue-tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node test/smoke.mjs",
    "db:migrate:local": "wrangler d1 migrations apply cheaper-fuel-discounts --local",
    "db:migrate:remote": "wrangler d1 migrations apply cheaper-fuel-discounts --remote",
    "discounts:migration": "node scripts/build-seed-migration.mjs",
    "discounts:check": "vitest run test/discounts-seed.test.ts",
    "discounts:verify": "node scripts/verify-discount-sources.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.30.0",
    "chart.js": "^4.6.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  }
}
